{
  "name": "jira",
  "slot": "tracker",
  "version": 1,
  "vendors": ["jira", "atlassian"],
  "capabilities": {
    "fetch_issue": {
      "via": "mcp",
      "requires": {
        "mcp": [
          "mcp__*__getJiraIssue"
        ]
      }
    },
    "import": {
      "via": "core"
    },
    "sync": {
      "via": "script",
      "command": [
        "python3",
        "scripts/sync.py",
        "--site",
        "{site}",
        "--keys",
        "{external_keys}"
      ],
      "requires": {
        "env": [
          "JIRA_USER_EMAIL",
          "JIRA_API_TOKEN"
        ],
        "files": [
          "~/.jira.env",
          "~/.env"
        ]
      }
    },
    "comment": {
      "via": "mcp",
      "requires": {
        "mcp": [
          "mcp__*__addCommentToJiraIssue"
        ]
      }
    }
  },
  "settings": {
    "site": {
      "type": "string",
      "default": null
    },
    "status_map": {
      "type": "list",
      "default": null
    }
  },
  "patterns": {
    "key_pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
    "url_pattern": "^https://[A-Za-z0-9-]+\\.atlassian\\.net/browse/(?P<key>[A-Z][A-Z0-9]+-[0-9]+)/?(?:[?#]\\S*)?$"
  }
}
